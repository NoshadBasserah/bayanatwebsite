---
import Logo from "@/components/Logo.astro";
import { siteConfig } from "@/site.config";

const cols: { title: string; links: { label: string; href: string }[] }[] = [
  { title: "Product", links: [
    { label: "Home", href: "/" },
    { label: "Status", href: "#" },
  ]},
  { title: "Resources", links: [
    { label: "Docs", href: "/docs" },
    { label: "Blog", href: "/blog" },
  ]},
  { title: "Company", links: [
    { label: "Contact", href: "mailto:hello@example.com" },
  ]},
  { title: "Legal", links: [
    { label: "Privacy", href: "#" },
    { label: "Terms", href: "#" },
  ]},
];
const year = new Date().getFullYear();
---

<footer class="bg-primaryColor text-neutral-300">
  <div class="section-inner px-6 md:px-12 py-16">
    <div class="grid grid-cols-2 md:grid-cols-6 gap-10">
      <div class="col-span-2">
        <Logo variant="reversed" />
        <p class="mt-4 text-sm text-neutral-400 max-w-xs leading-relaxed">
          Short tagline for your brand. Replace this copy in <code>src/components/layout/Footer.astro</code>.
        </p>
        <span class="mt-4 inline-flex items-center gap-2 rounded-full bg-white/[0.06] px-3 py-1 text-xs text-neutral-200">
          <span class="status-dot inline-block h-1.5 w-1.5 rounded-full bg-signal-success"></span>
          All systems normal
        </span>
      </div>
      {cols.map((c) => (
        <div>
          <h5 class="text-xs font-bold uppercase tracking-wider text-white">{c.title}</h5>
          <ul class="mt-3 space-y-2">
            {c.links.map((l) => (
              <li><a href={l.href} class="text-sm text-neutral-400 hover:text-white transition-colors">{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="mt-12 border-t border-neutral-800 pt-6 flex flex-wrap items-center justify-between gap-4 text-xs text-neutral-500">
      <span>© {year} {siteConfig.title} <span class="ml-1 inline-block h-1.5 w-1.5 rounded-sm align-middle bg-primary-600"></span></span>
      <div class="flex gap-4">
        <a href="#" class="hover:text-white transition-colors">Twitter</a>
        <a href="#" class="hover:text-white transition-colors">GitHub</a>
      </div>
    </div>
  </div>
</footer>
