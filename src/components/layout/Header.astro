---
import Logo from "@/components/Logo.astro";

const navLinks: { label: string; href: string }[] = [
  { label: "Home", href: "/" },
  { label: "Docs", href: "/docs" },
  { label: "Blog", href: "/blog" },
];
---

<header class="sticky top-0 z-40 border-b border-primaryColor/8 bg-neutral-50/85 backdrop-blur-md">
  <div class="section-inner flex h-16 items-center justify-between px-6 md:px-12">
    <div class="flex items-center gap-8">
      <a href="/" class="flex items-center" aria-label="Home">
        <Logo />
      </a>
      <nav class="hidden md:flex items-center gap-6 text-sm text-neutral-600">
        {navLinks.map((l) => (
          <a href={l.href} class="hover:text-primaryColor transition-colors">{l.label}</a>
        ))}
      </nav>
    </div>
    <div class="flex items-center gap-2">
      <a href="#" class="btn btn-ghost hidden sm:inline-flex">Sign in</a>
      <a href="#" class="btn btn-primary">Get started</a>
    </div>
  </div>
</header>
