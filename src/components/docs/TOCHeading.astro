---
import type { TocItem } from "@/utils/generateToc";

interface Props {
  heading: TocItem;
}

const {
  heading: { children, slug, text },
} = Astro.props;
---

<li>
  <a
    aria-label={`Scroll to section: ${text}`}
    class="text-neutral-600 hover:bg-neutral-50 hover:text-primaryColor block rounded-lg px-2 py-1.5 text-sm transition-colors"
    href={`#${slug}`}
  >
    {text}
  </a>
  {
    !!children.length && (
      <ul class="border-neutral-200 ml-2 rtl:ml-0 rtl:mr-2 border-l rtl:border-l-0 rtl:border-r pl-2 rtl:pl-0 rtl:pr-2">
        {children.map((subheading) => (
          <Astro.self heading={subheading} />
        ))}
      </ul>
    )
  }
</li>
