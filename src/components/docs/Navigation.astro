---
import { type CollectionEntry } from "astro:content";
import { type Lang, useTranslations, localePath } from "@/i18n/utils";
import { getNavSections } from "@/data/docsNav";

interface Props {
  post: CollectionEntry<"docs">;
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
const navSections = getNavSections(lang);
const overviewHref = localePath("/docs/", lang);
const currentUrl = Astro.url;

function normalize(path: string) {
  return path.endsWith("/") ? path : path + "/";
}

function isActive(href: string): boolean {
  return normalize(currentUrl.pathname) === normalize(href);
}

function isChildActive(children: { href: string }[]): boolean {
  return children.some((c) => isActive(c.href));
}

const overviewActive = isActive(overviewHref);
---

<nav class="px-3 py-4" aria-label="Documentation">
  <!-- OVERVIEW label -->
  <p class="mb-2 px-3 text-[10px] font-semibold uppercase tracking-[0.08em] text-[#949eb0]">
    {t("nav.overview")}
  </p>

  <!-- Overview link -->
  <a
    href={overviewHref}
    class:list={[
      "mb-3 flex items-center gap-2.5 rounded-[8px] px-3 py-2 text-[13px] font-medium transition-colors",
      overviewActive
        ? "bg-[#eff6ff] text-[#009ad6]"
        : "text-[#314158] hover:bg-neutral-50 hover:text-[#009ad6]",
    ]}
  >
    <span class="relative flex h-4 w-4 shrink-0">
      <span class="absolute left-0 top-0 h-[6px] w-[6px] rounded-[1.5px] bg-current"></span>
      <span class="absolute right-0 top-0 h-[6px] w-[6px] rounded-[1.5px] bg-current"></span>
      <span class="absolute bottom-0 left-0 h-[6px] w-[6px] rounded-[1.5px] bg-current"></span>
      <span class="absolute bottom-0 right-0 h-[6px] w-[6px] rounded-[1.5px] bg-current"></span>
    </span>
    {t("nav.overview")}
  </a>

  {navSections.map((section) => (
    <details class="group mb-1" open>
      <summary class="flex cursor-pointer list-none items-center justify-between rounded-[8px] px-3 py-2 text-[14px] font-medium text-[#314158] hover:bg-neutral-50 transition-colors select-none">
        <span>{section.label}</span>
        <svg
          class="h-4 w-4 shrink-0 text-[#949eb0] transition-transform duration-200 group-open:rotate-180"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path d="m6 9 6 6 6-6"/>
        </svg>
      </summary>

      <ul class="mt-0.5 space-y-0.5">
        {section.items.map((item) =>
          item.children ? (
            <li>
              <details
                class="group/sub"
                open={isActive(item.href) || isChildActive(item.children)}
              >
                <summary class:list={[
                  "flex cursor-pointer list-none items-center justify-between rounded-[8px] ps-[24px] pe-3 py-2 text-[14px] transition-colors select-none",
                  isActive(item.href)
                    ? "bg-[#eff6ff] font-medium text-[#009ad6]"
                    : "font-medium text-[#314158] hover:bg-neutral-50",
                ]}>
                  <span>{item.title}</span>
                  <svg
                    class="h-4 w-4 shrink-0 text-[#949eb0] transition-transform duration-200 group-open/sub:rotate-180"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path d="m6 9 6 6 6-6"/>
                  </svg>
                </summary>
                <ul class="mt-0.5 space-y-0.5">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class:list={[
                          "block rounded-[8px] py-2 ps-[36px] pe-3 text-[14px] transition-colors",
                          isActive(child.href)
                            ? "bg-[#eff6ff] font-medium text-[#009ad6]"
                            : "text-[#45556c] hover:bg-neutral-50 hover:text-[#314158]",
                        ]}
                      >
                        {child.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                class:list={[
                  "block rounded-[8px] py-2 ps-[24px] pe-3 text-[14px] transition-colors",
                  isActive(item.href)
                    ? "bg-[#eff6ff] font-medium text-[#009ad6]"
                    : "text-[#45556c] hover:bg-neutral-50 hover:text-[#314158]",
                ]}
              >
                {item.title}
              </a>
            </li>
          )
        )}
      </ul>
    </details>
  ))}
</nav>
