---

<div class="doc-info-card">
  <div class="doc-info-card__icon" style={`background:${bgMap[color]}`}>
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke={strokeMap[color]}
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      set:html={iconPaths[icon]}
    />
  </div>
  <p class="doc-info-card__title">{title}</p>
  <p class="doc-info-card__text">{description}</p>
</div>

<style>
  .doc-info-card {
    border: 1px solid #edf1f7;
    border-radius: 16px;
    background: white;
    padding: 1.25rem;
  }
  .doc-info-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 10px;
    margin-bottom: 0.75rem;
    flex-shrink: 0;
  }
  doc-info-card__icon > svg {
    width: 16px;
    height: auto;
  }

  .doc-info-card__title {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: #0f172a;
  }
  .doc-info-card__text {
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: #66758f;
  }
</style>
