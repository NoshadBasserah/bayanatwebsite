---
interface Props {
  title: string;
  description: string;
  icon: "search" | "filter" | "add" | "name" | "list" | "document";
  color?: "blue" | "purple" | "green";
}

const { title, description, icon, color = "blue" } = Astro.props;

const bgMap: Record<string, string> = {
  blue:   "#dbeafe",
  purple: "#ede9fe",
  green:  "#dcfce7",
};

const strokeMap: Record<string, string> = {
  blue:   "#2563eb",
  purple: "#7c3aed",
  green:  "#16a34a",
};

const iconPaths: Record<string, string> = {
  "search":   `<circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>`,
  "filter":   `<line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="14" y2="12"/><line x1="4" y1="18" x2="10" y2="18"/>`,
  "add":      `<path d="M12 5v14M5 12h14"/>`,
  "name":     `<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>`,
  "list":     `<line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>`,
  "document": `<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>`,
};
---

<div class="doc-feature-row">
  <div class="doc-feature-row__icon" style={`background:${bgMap[color]}`}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke={strokeMap[color]} stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" set:html={iconPaths[icon]} />
  </div>
  <div>
    <p class="doc-feature-row__title">{title}</p>
    <p class="doc-feature-row__text">{description}</p>
  </div>
</div>

<style>
  .doc-feature-row {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    border: none;
    border-radius: 16px;
    background: transparent;
    padding: 0;
  }
  .doc-feature-row__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 9999px;
    flex-shrink: 0;
  }
  .doc-feature-row__title {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: #0f172a;
  }
  .doc-feature-row__text {
    margin: 0.125rem 0 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: #66758f;
  }
</style>
