---
interface Props {
  title: string;
  variant?: "info" | "note";
}

const { title, variant = "info" } = Astro.props;
---

<aside class:list={["docs-guide-callout", `docs-guide-callout--${variant}`]}>
  <div class="docs-guide-callout__header">
    <span class="docs-guide-callout__icon" aria-hidden="true">
      {variant === "note" ? (
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20">
          <circle cx="10" cy="10" r="8.5"/>
          <path d="M10 9v5M10 7h.01" stroke-linecap="round"/>
        </svg>
      ) : (
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20">
          <circle cx="10" cy="10" r="8.5"/>
          <path d="M10 9v5M10 7h.01" stroke-linecap="round"/>
        </svg>
      )}
    </span>
    <h3>{title}</h3>
  </div>
  <div class="docs-guide-callout__content">
    <slot />
  </div>
</aside>
