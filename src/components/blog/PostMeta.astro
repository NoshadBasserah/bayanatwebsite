---
import FormattedDate from "@/components/FormattedDate.astro";

interface Props {
  publishDate: Date;
  readingTime: string;
  author: string;
  tags: string[];
  linkTags?: boolean;
  class?: string;
}

const {
  publishDate,
  readingTime,
  author,
  tags,
  linkTags = true,
  class: className,
} = Astro.props;
---

<div class:list={["font-mono text-xs uppercase tracking-[0.12em] text-neutral-500", className]}>
  <div class="flex flex-wrap items-center gap-x-1">
    <span class="uppercase">
      <FormattedDate
        date={publishDate}
        dateTimeOptions={{ year: "numeric", month: "short", day: "numeric" }}
      />
    </span>
    <span aria-hidden="true"> · </span>
    <span>{readingTime}</span>
    <span aria-hidden="true"> · </span>
    <span>By {author}</span>
  </div>

  {
    tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-2">
        {tags.map((tag) =>
          linkTags ? (
            <a
              href={`/blog/tag/${tag}/`}
              class="inline-flex items-center rounded-full px-2.5 py-1 text-[0.7rem] font-mono uppercase tracking-[0.1em] bg-neutral-100 text-neutral-700 transition-colors hover:bg-primary-100 hover:text-primary-800"
            >
              {tag}
            </a>
          ) : (
            <span class="inline-flex items-center rounded-full px-2.5 py-1 text-[0.7rem] font-mono uppercase tracking-[0.1em] bg-neutral-100 text-neutral-700">
              {tag}
            </span>
          )
        )}
      </div>
    )
  }
</div>
