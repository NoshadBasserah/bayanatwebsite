---
import type { CollectionEntry } from "astro:content";
import PostCover from "@/components/blog/PostCover.astro";
import PostMeta from "@/components/blog/PostMeta.astro";
import { readingTime } from "@/utils/readingTime";

interface Props {
  post: CollectionEntry<"post">;
}
const { post } = Astro.props;
const body = post.body ?? "";
const minutes = readingTime(body);
---

<article class="group relative flex flex-col rounded-2xl bg-white ring-1 ring-primaryColor/8 shadow-tile hover:shadow-tile-hover transition-shadow overflow-hidden">
  <a
    href={`/blog/${post.id}/`}
    class="block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500"
    data-astro-prefetch
  >
    <PostCover post={post} />
  </a>
  <div class="flex flex-col gap-4 p-6 md:p-7">
    <a href={`/blog/${post.id}/`} data-astro-prefetch class="block">
      <h3 class="font-display font-semibold text-primaryColor text-lg md:text-xl leading-snug group-hover:text-primary-800 transition-colors">
        {post.data.title}
      </h3>
    </a>
    <p class="text-neutral-600 text-sm leading-relaxed line-clamp-3">
      {post.data.description}
    </p>
    <PostMeta
      publishDate={post.data.publishDate}
      readingTime={minutes}
      author={post.data.author}
      tags={[]}
      class="mt-auto"
    />
  </div>
</article>
