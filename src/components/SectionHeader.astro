---
interface Props {
  eyebrow?: string;
  align?: "center" | "left";
  class?: string;
}
const { eyebrow, align = "center", class: cls = "" } = Astro.props;
const alignClass = align === "center" ? "text-center mx-auto" : "text-left";
---
<header class={`${alignClass} max-w-3xl ${cls} reveal`}>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h2 class="display-lg mt-5"><slot name="title" /></h2>
  {Astro.slots.has("kicker") && (
    <p class="body-lg mt-5 max-w-2xl mx-auto"><slot name="kicker" /></p>
  )}
</header>
