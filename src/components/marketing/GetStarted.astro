---
// Dark "Get started" CTA band.
const perks = ["14-day trial", "No credit card required", "Cancel any time"];
---

<section class="mk-section mk-gs__wrap" id="get-started">
  <div class="mk-container">
    <div class="mk-gs mk-reveal">
      <div class="mk-gs__glow" aria-hidden="true"></div>
      <div class="mk-gs__inner">
        <span class="mk-eyebrow mk-eyebrow--dot mk-eyebrow--center">Get started</span>
        <h2 class="mk-gs__title">
          Manage your data with clarity, control,<br />
          and <span class="mk-serif">confidence.</span>
        </h2>
        <p class="mk-gs__sub">
          Join the next generation of data-driven enterprises that prioritize
          trust over chaos.
        </p>
        <div class="mk-gs__actions">
          <a class="mk-btn mk-btn--primary mk-btn--lg" href="#">
            Book a demo
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a class="mk-btn mk-btn--on-dark mk-btn--lg" href="#">Start free trial</a>
        </div>
        <ul class="mk-gs__perks">
          {
            perks.map((p) => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12.5l4 4 10-10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {p}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .mk-gs__wrap { background: var(--mk-page); }
  .mk-gs {
    position: relative;
    overflow: hidden;
    border-radius: var(--mk-r-2xl);
    background: var(--mk-grad-dark);
    padding: clamp(48px, 7vw, 88px) 24px;
    text-align: center;
    isolation: isolate;
  }
  .mk-gs__glow {
    position: absolute;
    inset: -40% 20% auto;
    height: 120%;
    background: radial-gradient(60% 60% at 50% 0%, rgba(79, 216, 227, 0.22), transparent 70%);
    z-index: -1;
  }
  .mk-gs__inner { max-width: 680px; margin-inline: auto; }
  .mk-gs__title {
    margin-top: 16px;
    color: #fff;
    font-size: clamp(2rem, 1.3rem + 3vw, 3rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .mk-gs__title .mk-serif { color: var(--mk-brand-lighter); }
  .mk-gs__sub { margin: 18px auto 0; max-width: 460px; color: rgba(255, 255, 255, 0.66); line-height: 1.6; }
  .mk-gs__actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 30px; }
  .mk-gs__perks {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: flex;
    gap: 26px;
    justify-content: center;
    flex-wrap: wrap;
    font-family: var(--mk-font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.6);
  }
  .mk-gs__perks li { display: inline-flex; align-items: center; gap: 7px; }
  .mk-gs__perks svg { width: 15px; height: 15px; color: var(--mk-brand-lighter); }
</style>
