---
// Marketing site header — sticky, with language toggle + CTAs.
const nav = [
  { label: "Product", href: "/#platform" },
  { label: "Solutions", href: "/#outcomes" },
  { label: "Documentation", href: "/docs/" },
  { label: "About", href: "/about/" },
];
---

<header class="mkh" data-mk-header>
  <div class="mk-container mkh__bar">
    <a class="mkh__brand" href="/" aria-label="BayanatiHub home">
      <svg class="mkh__mark" viewBox="0 0 40 40" fill="none" aria-hidden="true">
        <defs>
          <linearGradient id="bmk" x1="6" y1="4" x2="34" y2="36" gradientUnits="userSpaceOnUse">
            <stop stop-color="#4FD8E3" />
            <stop offset="0.5" stop-color="#1FBECD" />
            <stop offset="1" stop-color="#009AD6" />
          </linearGradient>
        </defs>
        <path
          d="M14 5c-1.7 0-3 1.3-3 3v9.4A8.6 8.6 0 0 1 17.4 15 8.6 8.6 0 1 1 11 29.3V32c0 1.7 1.3 3 3 3 .9 0 1.7-.4 2.3-1A11.4 11.4 0 0 0 31 23.6 11.6 11.6 0 0 0 17 12.4V8c0-1.7-1.3-3-3-3Z"
          fill="url(#bmk)"
        />
        <circle cx="17.6" cy="23.6" r="4.4" fill="#0B1530" fill-opacity="0.12" />
        <circle cx="17.6" cy="23.6" r="4.4" fill="url(#bmk)" />
      </svg>
      <span class="mkh__word">Bayanati<span class="mkh__word-sub">Hub</span></span>
    </a>

    <nav class="mkh__nav" aria-label="Primary">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>

    <div class="mkh__actions">
      <div class="mkh__lang" role="group" aria-label="Language">
        <button class="is-active" type="button">EN</button>
        <button type="button">AR</button>
      </div>
      <a class="mkh__login" href="/login/">Log in</a>
      <a class="mk-btn mk-btn--dark mk-btn--sm" href="/#get-started">
        Book a demo
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <button class="mkh__burger" type="button" aria-label="Toggle menu" data-mk-burger>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>

  <div class="mkh__mobile" data-mk-mobile>
    <nav aria-label="Mobile">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      <a href="/login/">Log in</a>
    </nav>
  </div>
</header>

<style>
  .mkh {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--mk-page) 82%, transparent);
    backdrop-filter: saturate(140%) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s var(--mk-ease), background 0.2s var(--mk-ease);
  }
  .mkh[data-scrolled] {
    border-bottom-color: var(--mk-border);
    background: color-mix(in srgb, var(--mk-page) 92%, transparent);
  }
  .mkh__bar {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 68px;
  }
  .mkh__brand { display: inline-flex; align-items: center; gap: 9px; }
  .mkh__mark { width: 34px; height: 34px; }
  .mkh__word { font-weight: 800; font-size: 1.15rem; color: var(--mk-heading); letter-spacing: -0.02em; }
  .mkh__word-sub { font-weight: 600; color: var(--mk-muted); font-size: 0.7rem; margin-left: 2px; vertical-align: 2px; }

  .mkh__nav { display: flex; align-items: center; gap: 28px; margin-left: 12px; }
  .mkh__nav a {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--mk-text-strong);
    transition: color 0.16s var(--mk-ease);
  }
  .mkh__nav a:hover { color: var(--mk-brand-ink); }

  .mkh__actions { display: flex; align-items: center; gap: 14px; margin-left: auto; }
  .mkh__lang {
    display: inline-flex;
    background: var(--mk-surface-alt);
    border: 1px solid var(--mk-border);
    border-radius: var(--mk-r-pill);
    padding: 3px;
  }
  .mkh__lang button {
    border: 0;
    background: transparent;
    font-family: var(--mk-font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--mk-muted);
    padding: 4px 9px;
    border-radius: var(--mk-r-pill);
    cursor: pointer;
  }
  .mkh__lang button.is-active { background: var(--mk-heading); color: #fff; }
  .mkh__login { font-size: 0.9375rem; font-weight: 700; color: var(--mk-heading); }
  .mkh__login:hover { color: var(--mk-brand-ink); }

  .mkh__burger { display: none; border: 0; background: transparent; color: var(--mk-heading); cursor: pointer; }
  .mkh__burger svg { width: 24px; height: 24px; }

  .mkh__mobile { display: none; border-top: 1px solid var(--mk-border); background: var(--mk-surface); }
  .mkh__mobile nav { display: flex; flex-direction: column; padding: 8px 0; }
  .mkh__mobile a { padding: 12px var(--mk-gutter); font-weight: 600; color: var(--mk-text-strong); }
  .mkh__mobile.is-open { display: block; }

  @media (max-width: 900px) {
    .mkh__nav, .mkh__login, .mkh__lang { display: none; }
    .mkh__burger { display: inline-flex; }
  }
</style>

<script>
  // Header border on scroll
  const header = document.querySelector<HTMLElement>("[data-mk-header]");
  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 8) header.setAttribute("data-scrolled", "");
    else header.removeAttribute("data-scrolled");
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  // Mobile menu
  const burger = document.querySelector("[data-mk-burger]");
  const mobile = document.querySelector("[data-mk-mobile]");
  burger?.addEventListener("click", () => mobile?.classList.toggle("is-open"));
</script>
