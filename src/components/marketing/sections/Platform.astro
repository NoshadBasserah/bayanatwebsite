---
const cards = [
  {
    title: "Centralized Data Assets",
    desc: "Map every table, dashboard, and API across your organization into one searchable, semantic layer.",
    variant: "",
    icon: "database",
  },
  {
    title: "Access Governance",
    desc: "Implement granular RBAC, approval workflows, and audit trails at enterprise scale.",
    variant: "mk-ico--violet",
    icon: "shield",
  },
  {
    title: "Self-Service Discovery",
    desc: "Let analysts and engineers find the data they need with rich, trusted business context.",
    variant: "mk-ico--amber",
    icon: "compass",
  },
  {
    title: "Teams & Collaboration",
    desc: "Align governance with context, sharing, and team-aware workflows that scale with your org.",
    variant: "mk-ico--success",
    icon: "people",
  },
];

const paths: Record<string, string> = {
  database: "M12 3c-4 0-7 1.3-7 3v12c0 1.7 3 3 7 3s7-1.3 7-3V6c0-1.7-3-3-7-3Zm7 7c0 1.7-3 3-7 3s-7-1.3-7-3M5 6c0 1.7 3 3 7 3s7-1.3 7-3",
  shield: "M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6l7-3Zm-3 8.5l2 2 4-4.5",
  compass: "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm3.5-12.5L13.5 13l-4.5 2 2-4.5 4.5-2Z",
  people: "M8 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm8 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM3 20v-1a4 4 0 0 1 4-4h2a4 4 0 0 1 4 4v1M14 20v-1a4 4 0 0 1 4-4h0a4 4 0 0 1 4 4v1",
};
---

<section class="mk-section mk-section--alt" id="platform">
  <div class="mk-container">
    <div class="mk-head mk-reveal">
      <span class="mk-eyebrow mk-eyebrow--dash mk-eyebrow--center">Platform</span>
      <h2 class="mk-h2" style="margin-top:14px">
        Everything your data org needs,<br />
        <span class="mk-serif">elegantly unified.</span>
      </h2>
      <p class="mk-lead">
        Four foundations that turn scattered enterprise data into a clear,
        governed, self-service experience.
      </p>
    </div>

    <div class="mk-grid mk-grid--4 plat__grid mk-reveal" data-mk-stagger>
      {
        cards.map((c) => (
          <article class="mk-card mk-card--pad mk-card--hover plat__card">
            <span class={`mk-ico ${c.variant}`}>
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d={paths[c.icon]} stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <h3 class="plat__title">{c.title}</h3>
            <p class="mk-body plat__desc">{c.desc}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .plat__grid { margin-top: 44px; }
  .plat__card { display: flex; flex-direction: column; gap: 14px; }
  .plat__title { font-size: 1.0625rem; font-weight: 800; color: var(--mk-heading); }
  .plat__desc { margin-top: -4px; }
</style>
