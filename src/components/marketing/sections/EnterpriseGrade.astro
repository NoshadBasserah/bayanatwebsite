---
const features = [
  {
    title: "SOC 2 Type II & GDPR-ready by design",
    desc: "Continuous controls, automated evidence, region pinning.",
    icon: "M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6l7-3Zm-3 8.5l2 2 4-4.5",
  },
  {
    title: "End-to-end visibility across enterprise systems",
    desc: "Lineage that spans warehouses, BI, lakes, and pipelines.",
    icon: "M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Zm10 3a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z",
  },
  {
    title: "Configurable RBAC and audit trails",
    desc: "Granular policies. Every action recorded. Tamper-proof.",
    icon: "M9 12l2 2 4-4M7 4h10a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z",
  },
];
const badges = ["SOC 2", "GDPR", "HIPAA", "ISO 27001", "CCPA"];
const stats = [
  { num: "99.9%", label: "uptime reliability", meta: "MULTI-REGION · AUTOMATED FAILOVER", wave: true },
  { num: "25M+", label: "assets indexed", meta: "ACROSS 120+ DATA SOURCES" },
  { num: "1 platform", label: "for governance, discovery & access", meta: "REPLACES 3–5 SINGLE-PURPOSE TOOLS" },
];
---

<section class="eg mk-dark" id="enterprise">
  <div class="mk-container eg__grid">
    <div class="eg__copy mk-reveal">
      <span class="mk-eyebrow mk-eyebrow--dot">Enterprise grade</span>
      <h2 class="eg__title">
        Built for governed, secure,<br />
        <span class="mk-serif">enterprise data operations.</span>
      </h2>
      <p class="eg__lead">
        We provide the guardrails so your team can move faster. Centralize who
        knows what is built, who owns it, and how it's accessed — across every
        system in your stack.
      </p>

      <ul class="eg__features">
        {
          features.map((f) => (
            <li>
              <span class="eg__ico">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d={f.icon} stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <div>
                <p class="eg__ft">{f.title}</p>
                <p class="eg__fd">{f.desc}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <ul class="eg__badges">
        {badges.map((b) => <li>{b}</li>)}
      </ul>
    </div>

    <div class="eg__stats mk-reveal" data-mk-stagger>
      {
        stats.map((s) => (
          <div class={`eg__stat mk-reveal${s.wave ? " eg__stat--feature" : ""}`}>
            <span class="eg__num">{s.num}</span>
            <span class="eg__label">{s.label}</span>
            <span class="eg__meta">{s.meta}</span>
            {s.wave && (
              <svg class="eg__wave" viewBox="0 0 320 60" fill="none" preserveAspectRatio="none" aria-hidden="true">
                <path d="M0 45 C40 20 70 50 110 35 S190 10 230 30 300 45 320 28 L320 60 L0 60 Z" fill="url(#egw)" opacity="0.5" />
                <defs>
                  <linearGradient id="egw" x1="0" y1="0" x2="0" y2="60">
                    <stop stop-color="#4FD8E3" stop-opacity="0.5" />
                    <stop offset="1" stop-color="#4FD8E3" stop-opacity="0" />
                  </linearGradient>
                </defs>
              </svg>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .eg { position: relative; padding-block: clamp(56px, 8vw, 104px); overflow: hidden; }
  .eg__grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 56px; align-items: center; }
  .eg__title { margin-top: 18px; font-size: clamp(1.8rem, 1.2rem + 2.2vw, 2.5rem); font-weight: 800; line-height: 1.12; letter-spacing: -0.025em; }
  .eg__title .mk-serif { color: var(--mk-brand-lighter); }
  .eg__lead { margin-top: 18px; max-width: 480px; color: rgba(255, 255, 255, 0.62); line-height: 1.65; }

  .eg__features { list-style: none; margin: 30px 0 0; padding: 0; display: grid; gap: 18px; }
  .eg__features li { display: flex; gap: 14px; align-items: flex-start; }
  .eg__ico {
    display: inline-flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; flex: none;
    border-radius: var(--mk-r-xs);
    background: rgba(79, 216, 227, 0.12);
    color: var(--mk-brand-lighter);
  }
  .eg__ico svg { width: 18px; height: 18px; }
  .eg__ft { font-weight: 700; color: #fff; font-size: 0.9375rem; }
  .eg__fd { color: rgba(255, 255, 255, 0.55); font-size: 0.8125rem; margin-top: 2px; }

  .eg__badges {
    list-style: none; margin: 30px 0 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 8px;
  }
  .eg__badges li {
    font-family: var(--mk-font-mono); font-size: 0.6875rem; letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--mk-r-xs);
    padding: 5px 10px;
  }

  .eg__stats { display: grid; gap: 14px; }
  .eg__stat {
    position: relative; overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
    border-radius: var(--mk-r-lg);
    padding: 22px 24px;
  }
  .eg__stat--feature { background: rgba(79, 216, 227, 0.06); border-color: rgba(79, 216, 227, 0.14); padding-bottom: 30px; }
  .eg__num { display: block; font-size: clamp(1.8rem, 1.4rem + 1.4vw, 2.4rem); font-weight: 800; letter-spacing: -0.02em; color: #fff; }
  .eg__stat--feature .eg__num {
    background: linear-gradient(90deg, #97ecf2, #4fd8e3);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .eg__label { display: block; color: rgba(255, 255, 255, 0.78); font-size: 0.9375rem; margin-top: 4px; }
  .eg__meta { display: block; font-family: var(--mk-font-mono); font-size: 0.625rem; letter-spacing: 0.08em; color: rgba(255, 255, 255, 0.4); margin-top: 6px; }
  .eg__wave { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 48px; }

  @media (max-width: 900px) {
    .eg__grid { grid-template-columns: 1fr; gap: 40px; }
  }
</style>
