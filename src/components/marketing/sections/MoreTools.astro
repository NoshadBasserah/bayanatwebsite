---
const tools = [
  {
    title: "Asset Connections",
    desc: "Discover relationships between datasets, dashboards, and APIs automatically.",
    icon: "M9 15l6-6M10 8H8a4 4 0 0 0 0 8h2M14 16h2a4 4 0 0 0 0-8h-2",
  },
  {
    title: "Business Glossary",
    desc: "A shared language of metrics, KPIs, and definitions across the organization.",
    icon: "M5 4h11a2 2 0 0 1 2 2v14H7a2 2 0 0 0-2 2V4ZM5 4v16",
  },
  {
    title: "Teams & Spaces",
    desc: "Workspaces with scoped permissions, ownership, and shared context per team.",
    icon: "M4 4h7v7H4V4Zm9 0h7v7h-7V4ZM4 13h7v7H4v-7Zm9 0h7v7h-7v-7Z",
  },
  {
    title: "Project Planner",
    desc: "Plan data initiatives with milestones, owners, and dataset dependencies.",
    icon: "M7 3v3M17 3v3M4 8h16M5 6h14a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1Z",
  },
];
---

<section class="mk-section mk-section--alt" id="more-tools">
  <div class="mk-container">
    <div class="mt__head mk-reveal">
      <span class="mk-eyebrow mk-eyebrow--dash">More tools</span>
      <h2 class="mk-h2" style="margin-top:14px; max-width:480px">
        Built for the way data teams actually work.
      </h2>
    </div>

    <div class="mk-grid mk-grid--4 mt__grid mk-reveal" data-mk-stagger>
      {
        tools.map((t) => (
          <article class="mk-card mk-card--pad mk-card--hover mt__card">
            <span class="mk-ico">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d={t.icon} stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <h3 class="mt__title">{t.title}</h3>
            <p class="mk-body mt__desc">{t.desc}</p>
            <a class="mk-link" href="#">Learn more
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .mt__grid { margin-top: 36px; }
  .mt__card { display: flex; flex-direction: column; gap: 12px; }
  .mt__title { font-size: 1rem; font-weight: 800; color: var(--mk-heading); }
  .mt__desc { flex: 1; }
  .mt__card .mk-link { margin-top: 4px; }
</style>
