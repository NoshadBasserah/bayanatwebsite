---
import { type CollectionEntry, render } from "astro:content";
import Base from "@/layouts/Base.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import PostMeta from "@/components/blog/PostMeta.astro";
import TocSidebar from "@/components/blog/TocSidebar.astro";
import BlogCta from "@/components/blog/BlogCta.astro";
import { readingTime } from "@/utils/readingTime";

interface Props {
  post: CollectionEntry<"post">;
}

const { post } = Astro.props;
const { ogImage, title, description, updatedDate, publishDate, tags, author } = post.data;
const socialImage = ogImage ?? `/og-image/${post.id}.png`;
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString();
const { headings } = await render(post);
const firstTag = tags?.[0];
const restTags = tags?.slice(1) ?? [];
const minutes = readingTime(post.body ?? "");
---

<Base meta={{ articleDate, description, ogImage: socialImage, title }}>
  <!-- Quiet centered hero -->
  <section slot="hero" class="section bg-neutral-50">
    <div class="section-inner px-6 md:px-12 pt-20 md:pt-28 pb-8 md:pb-10 text-center">
      {firstTag && (
        <a href={`/blog/tag/${firstTag}/`} class="inline-block">
          <Eyebrow>{firstTag}</Eyebrow>
        </a>
      )}
      <h1 class="display-md mt-4 mx-auto max-w-[44rem]">{title}</h1>
      <div class="mt-5 flex justify-center">
        <PostMeta
          publishDate={publishDate}
          readingTime={minutes}
          author={author}
          tags={restTags}
        />
      </div>
    </div>
  </section>

  <!-- Body + TOC -->
  <section class="section bg-neutral-50">
    <div class="section-inner px-6 md:px-12 pb-16 md:pb-20">
      <div class="mx-auto max-w-[62rem] grid grid-cols-1 lg:grid-cols-[minmax(0,_46rem)_14rem] gap-10 lg:gap-14">
        <article class="blog-prose min-w-0">
          <slot />
        </article>
        {headings.length > 0 && (
          <aside class="hidden lg:block">
            <TocSidebar headings={headings} />
          </aside>
        )}
      </div>
    </div>
  </section>

  <!-- End-of-post CTA -->
  <section class="section bg-neutral-50">
    <div class="section-inner px-6 md:px-12 pb-8">
      <BlogCta />
    </div>
  </section>

  <!-- Back link -->
  <section class="section bg-neutral-50">
    <div class="section-inner px-6 md:px-12 pb-24 md:pb-28 text-center">
      <a href="/blog" class="inline-flex items-center gap-1.5 text-sm text-neutral-500 hover:text-primary-700 transition-colors">
        ← All guides
      </a>
    </div>
  </section>
</Base>

<!-- Copy code button (preserved from previous implementation) -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll("pre").forEach((pre) => {
      if (!pre.querySelector(".copy-code")) {
        const copyButton = document.createElement("button");
        copyButton.className =
          "copy-code absolute flex items-center justify-center h-6 font-medium overflow-hidden rounded-md text-neutral-300 hover:text-primary-500 font-mono text-xs top-3 right-3";

        const buttonText = document.createElement("span");
        buttonText.innerText = "Copy";
        buttonText.className = "flex items-center block w-full h-full px-2";

        copyButton.appendChild(buttonText);
        pre.appendChild(copyButton);

        copyButton.addEventListener("click", async () => {
          const code = pre.querySelector("code")?.textContent;
          if (code) {
            await navigator.clipboard.writeText(code);
            buttonText.innerText = "Copied!";
            setTimeout(() => {
              buttonText.innerText = "Copy";
            }, 1500);
          }
        });
      }
    });
  });
</script>
