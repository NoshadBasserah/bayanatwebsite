---
import "@/styles/marketing.css";
import SiteHeader from "@/components/marketing/SiteHeader.astro";
import SiteFooter from "@/components/marketing/SiteFooter.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "BayanatiHub — The control plane for your data",
  description = "BayanatiHub enables teams to discover, govern, and use data with confidence through structured access, metadata management, and intelligent workflows.",
} = Astro.props;
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* Fonts: Manrope (UI) · Instrument Serif (italic emphasis) · JetBrains Mono (labels) */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Instrument+Serif:ital@1&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    {/* Mark JS on before first paint so reveal animations don't flash */}
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body class="mk">
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />

    <script>
      // Scroll reveal — adds .is-visible when an element enters the viewport.
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const items = document.querySelectorAll<HTMLElement>(".mk-reveal, [data-mk-stagger]");
      if (!reduce && "IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                e.target
                  .querySelectorAll(".mk-reveal")
                  .forEach((c) => c.classList.add("is-visible"));
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add("is-visible"));
      }

      // FAQ accordion
      document.querySelectorAll<HTMLButtonElement>("[data-faq-trigger]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const item = btn.closest("[data-faq]");
          if (!item) return;
          const open = item.classList.contains("is-open");
          document.querySelectorAll("[data-faq].is-open").forEach((el) => el.classList.remove("is-open"));
          if (!open) item.classList.add("is-open");
        });
      });
    </script>
  </body>
</html>
