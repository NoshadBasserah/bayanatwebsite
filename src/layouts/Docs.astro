---
import { type CollectionEntry, render } from "astro:content";
import Navigation from "@/components/docs/Navigation.astro";
import OverviewCards from "@/components/docs/OverviewCards.astro";
import SearchBar from "@/components/docs/SearchBar.astro";
import BaseHead from "@/components/BaseHead.astro";
import SkipLink from "@/components/SkipLink.astro";
import Logo from "@/components/Logo.astro";
import { siteConfig } from "@/site.config";
import { getNavSections, flattenNavItems } from "@/data/docsNav";
import { type Lang, useTranslations, switchLangPath } from "@/i18n/utils";

interface Props {
  post: CollectionEntry<"docs">;
  lang?: Lang;
}

const { post, lang = "en" } = Astro.props;
const t = useTranslations(lang);
const isRtl = lang === "ar";

const { title, description, adminFeatures, userFeatures, layoutStyle } = post.data;
const isOverview = post.id === "index" || post.id === "" || post.id === "ar" || post.id === "ar/index";
const isGuide = layoutStyle === "guide";

const { headings: markdownHeadings } = await render(post);

const overviewHeadings = [
  { depth: 2, slug: "introduction", text: t("overview.intro") },
  { depth: 2, slug: "as-admin-role", text: t("overview.asAdminRole") },
  { depth: 2, slug: "as-user-role", text: t("overview.asUserRole") },
];
const tocHeadings = isOverview ? overviewHeadings : markdownHeadings;

const navSections = getNavSections(lang);
const allPages = flattenNavItems(navSections, lang);

function normalize(p: string) {
  return p.endsWith("/") ? p : p + "/";
}

const currentPath = normalize(Astro.url.pathname);
const currentIdx = allPages.findIndex((p) => normalize(p.href) === currentPath);

const overviewHref = lang === "ar" ? "/ar/docs/" : "/docs/";

const prevPage =
  currentIdx > 0
    ? allPages[currentIdx - 1]
    : isOverview
      ? { title: t("nav.overview"), href: overviewHref }
      : null;

const nextPage =
  currentIdx >= 0 && currentIdx < allPages.length - 1
    ? allPages[currentIdx + 1]
    : null;

const arPath = switchLangPath(Astro.url.pathname, "ar");
const enPath = switchLangPath(Astro.url.pathname, "en");
---

<html
  class="scroll-pt-[88px] scroll-smooth antialiased"
  class:list={[isRtl ? "font-arabic" : "font-sans"]}
  lang={isRtl ? "ar" : siteConfig.lang}
  dir={isRtl ? "rtl" : "ltr"}
  data-theme="light"
>
  <head>
    <BaseHead description={description} title={title} />
  </head>
  <body class="bg-neutral-50 text-neutral-800">
    <SkipLink />

    <div class="flex min-h-screen">
      <!-- ── Left Sidebar (right in RTL) ── -->
      <aside class="hidden lg:flex w-[240px] shrink-0 sticky top-0 h-screen flex-col border-e border-neutral-100 bg-white overflow-y-auto z-20">
        <!-- Logo -->
        <div class="flex h-[72px] shrink-0 items-center border-b border-neutral-100 px-5">
          <a href={isRtl ? "/ar/docs/" : "/"} aria-label="BayanatiHub home">
            <Logo class="h-[47px] w-auto" />
          </a>
        </div>

        <!-- Navigation -->
        <div class="flex-1 overflow-y-auto">
          <Navigation post={post} lang={lang} />
        </div>

        <!-- Need help card -->
        <div class="shrink-0 p-3 pb-5">
          <div class="overflow-hidden rounded-[14px] border border-neutral-100 bg-gradient-to-b from-white to-[#e3f7ff] p-4">
            <p class="text-sm font-semibold text-[#0f172a]">{t("sidebar.needHelp")}</p>
            <p class="mt-1 text-[11px] leading-[16px] text-[#6b7689]">
              {t("sidebar.needHelpDesc")}
            </p>
            <a
              href="#"
              class="mt-3 flex h-[34px] items-center justify-between rounded-[8px] border border-[#e5ecfe] bg-white px-3 text-[11.5px] font-semibold text-[#009ad6] transition-colors hover:bg-[#eff6ff]"
            >
              <span>{t("sidebar.viewHelpCenter")}</span>
              <span aria-hidden="true">{isRtl ? "←" : "→"}</span>
            </a>
          </div>
        </div>
      </aside>

      <!-- ── Mobile backdrop ── -->
      <div id="mobile-backdrop" class="lg:hidden fixed inset-0 z-30 bg-black/40 opacity-0 pointer-events-none transition-opacity duration-300" aria-hidden="true"></div>

      <!-- ── Mobile drawer ── -->
      <aside id="mobile-drawer" class="lg:hidden fixed inset-y-0 start-0 z-40 flex w-[260px] flex-col border-e border-neutral-100 bg-white overflow-y-auto transition-transform duration-300" style={isRtl ? "transform: translateX(100%)" : "transform: translateX(-100%)"}>
        <div class="flex h-[72px] shrink-0 items-center justify-between border-b border-neutral-100 px-5">
          <a href={isRtl ? "/ar/docs/" : "/"} aria-label="BayanatiHub home">
            <Logo class="h-[47px] w-auto" />
          </a>
          <button id="mobile-menu-close" class="flex h-8 w-8 items-center justify-center rounded-lg text-[#949eb0] hover:bg-neutral-50 transition-colors" aria-label="Close navigation">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" viewBox="0 0 24 24">
              <path d="M18 6 6 18M6 6l12 12"/>
            </svg>
          </button>
        </div>
        <div class="flex-1 overflow-y-auto">
          <Navigation post={post} lang={lang} />
        </div>
        <div class="shrink-0 p-3 pb-5">
          <div class="overflow-hidden rounded-[14px] border border-neutral-100 bg-gradient-to-b from-white to-[#e3f7ff] p-4">
            <p class="text-sm font-semibold text-[#0f172a]">{t("sidebar.needHelp")}</p>
            <p class="mt-1 text-[11px] leading-[16px] text-[#6b7689]">{t("sidebar.needHelpDesc")}</p>
            <a href="#" class="mt-3 flex h-[34px] items-center justify-between rounded-[8px] border border-[#e5ecfe] bg-white px-3 text-[11.5px] font-semibold text-[#009ad6] transition-colors hover:bg-[#eff6ff]">
              <span>{t("sidebar.viewHelpCenter")}</span>
              <span aria-hidden="true">{isRtl ? "←" : "→"}</span>
            </a>
          </div>
        </div>
      </aside>

      <!-- ── Main area ── -->
      <div class="flex flex-1 flex-col min-w-0">
        <!-- Top header -->
        <header class="sticky top-0 z-10 flex h-[72px] shrink-0 items-center justify-between border-b border-neutral-100 bg-white px-4 sm:px-6 gap-3">
          <!-- Mobile menu button -->
          <button id="mobile-menu-btn" class="lg:hidden flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-[#314158] hover:bg-neutral-50 transition-colors" aria-label="Open navigation">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <path d="M3 12h18M3 6h18M3 18h18"/>
            </svg>
          </button>
          <!-- Search bar -->
          <SearchBar />

          <!-- Right controls -->
          <div class="flex shrink-0 items-center gap-3">
            <!-- Theme toggle -->
            <!-- <button aria-label={t("header.toggleTheme")} class="hidden cursor-pointer sm:flex h-8 w-8 items-center justify-center rounded-full text-neutral-800 hover:bg-neutral-50 transition-colors [&>svg]:w-6 [&>svg]:h-auto">
              <svg class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
              </svg>
            </button> -->

            <!-- Language toggle: show only the OTHER language -->
            {isRtl ? (
              <a
                href={enPath}
                class="hidden sm:flex items-center gap-1.5 rounded-full px-2 py-1 text-[0.7188rem] font-medium transition-colors text-neutral-800 hover:bg-neutral-50"
              >
                <span>English</span>
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                </svg>
              </a>
            ) : (
              <a
                href={arPath}
                class="hidden sm:flex items-center gap-1.5 rounded-full px-2 py-1 text-[0.7188rem] font-medium transition-colors text-neutral-800 hover:bg-neutral-50"
              >
                <span>العربية</span>
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                </svg>
              </a>
            )}
          </div>
        </header>

        <!-- ── Content area ── -->
        <div class="flex flex-1">
          <main id="main-content" class="flex-1 min-w-0 p-4 sm:p-6 lg:p-8">
            {isOverview ? (
              <OverviewCards
                title={title}
                description={description}
                adminFeatures={adminFeatures ?? []}
                userFeatures={userFeatures ?? []}
                lang={lang}
              />
            ) : isGuide ? (
              <article data-docs-content class="docs-guide">
                <slot />
              </article>
            ) : (
              <>
                <!-- Hero banner -->
                <div
                  class="relative mb-6 flex h-[182px] items-end overflow-hidden rounded-[14px] p-6"
                  style="background: linear-gradient(168deg, #81cae7 0%, #009ad6 70.7%)"
                >
                  <div class="relative ">
                    <h1 class="text-3xl font-bold leading-tight text-white">{title}</h1>
                    <p class="mt-1 max-w-2xl text-[15px] leading-relaxed text-white/90">{description}</p>
                  </div>
                  <div class="pointer-events-none absolute -right-10 rtl:right-auto rtl:-left-10 -top-14 h-52 w-52 rounded-full bg-white/10"></div>
                  <div class="pointer-events-none absolute right-16 rtl:right-auto rtl:left-16 top-2 h-36 w-36 rounded-full bg-white/10"></div>
                </div>
                <article
                  data-docs-content
                  class="prose prose-headings:font-semibold prose-headings:text-[#0f172a] prose-p:text-primary-600 prose-a:text-[#009ad6] hover:prose-a:text-[#007ab8] max-w-none rounded-xl bg-white p-6 ring-1 ring-[#f0f3f7] shadow-sm sm:p-8"
                >
                  <slot />
                </article>
              </>
            )}

            <!-- ── Prev / Next ── -->
            {(prevPage || nextPage) && (
              <div class="mt-6 flex gap-4">
                {prevPage ? (
                  <a
                    href={prevPage.href}
                    class="flex flex-1 items-center gap-4 rounded-[14px] border border-neutral-100 bg-white px-5 py-5 shadow-[0px_2px_8px_0px_rgba(24,36,64,0.03)] transition-shadow hover:shadow-md"
                  >
                    <span class="text-[18px] font-medium text-[#6b7689]">{isRtl ? "→" : "←"}</span>
                    <div>
                      <p class="text-[11px] font-medium uppercase tracking-[0.04em] text-[#6b7689]">{t("pagination.previous")}</p>
                      <p class="mt-0.5 text-[15px] font-semibold tracking-[-0.003em] text-[#0f172a]">{prevPage.title}</p>
                    </div>
                  </a>
                ) : (
                  <div class="flex-1" />
                )}

                {nextPage ? (
                  <a
                    href={nextPage.href}
                    class="flex flex-1 items-center justify-end gap-4 rounded-[14px] border border-neutral-100 bg-white px-5 py-5 shadow-[0px_2px_8px_0px_rgba(24,36,64,0.03)] transition-shadow hover:shadow-md"
                  >
                    <div class="text-end">
                      <p class="text-[11px] font-medium uppercase tracking-[0.04em] text-[#6b7689]">{t("pagination.next")}</p>
                      <p class="mt-0.5 text-[15px] font-semibold tracking-[-0.003em] text-[#0f172a]">{nextPage.title}</p>
                    </div>
                    <span class="text-[18px] font-medium text-[#6b7689]">{isRtl ? "←" : "→"}</span>
                  </a>
                ) : (
                  <div class="flex-1" />
                )}
              </div>
            )}
          </main>

          <!-- ── Right TOC ── -->
          {tocHeadings.length > 0 && (
            <aside class="hidden xl:block w-[260px] shrink-0 sticky top-[72px] h-[calc(100vh-72px)] overflow-y-auto p-5 ps-0">
              <div class="rounded-[14px] border border-neutral-100 bg-white p-4 shadow-[0px_2px_8px_rgba(24,36,64,0.03)]">
                <p class="mb-3 text-sm font-semibold tracking-[-0.003em] text-[#0f172a]">{t("toc.onThisPage")}</p>
                <div class="mb-3 h-px bg-[#f0f3f7]"></div>
                <ul class="space-y-[10px]">
                  {tocHeadings.map((h, i) => (
                    <li class="flex items-center gap-2">
                      <div class:list={[
                        "h-[18px] w-[2.5px] shrink-0 rounded-xl transition-colors",
                        i === 0 ? "bg-[#009ad6]" : "bg-transparent",
                      ]} />
                      <a
                        href={`#${h.slug}`}
                        class:list={[
                          "text-[12.5px] leading-5 transition-colors",
                          i === 0
                            ? "font-semibold text-[#009ad6]"
                            : "font-medium text-[#374151] hover:text-[#009ad6]",
                        ]}
                      >
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </aside>
          )}
        </div>
      </div>
    </div>
    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const closeBtn = document.getElementById('mobile-menu-close');
      const backdrop = document.getElementById('mobile-backdrop');
      const drawer = document.getElementById('mobile-drawer');

      if (btn && backdrop && drawer) {
        const isRtl = document.documentElement.dir === 'rtl';
        const hiddenTransform = isRtl ? 'translateX(100%)' : 'translateX(-100%)';

        function openMenu() {
          drawer.style.transform = 'translateX(0)';
          backdrop.style.opacity = '1';
          backdrop.style.pointerEvents = 'auto';
          document.body.style.overflow = 'hidden';
        }

        function closeMenu() {
          drawer.style.transform = hiddenTransform;
          backdrop.style.opacity = '0';
          backdrop.style.pointerEvents = 'none';
          document.body.style.overflow = '';
        }

        btn.addEventListener('click', openMenu);
        backdrop.addEventListener('click', closeMenu);
        closeBtn?.addEventListener('click', closeMenu);
      }
    </script>
  </body>
</html>
