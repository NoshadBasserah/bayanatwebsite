---
import Eyebrow from "@/components/Eyebrow.astro";
import Button from "@/components/Button.astro";

const stats = [
  { value: "1",   label: "metric one" },
  { value: "2",   label: "metric two" },
  { value: "3",   label: "metric three" },
];
---

<section class="section relative overflow-hidden bg-neutral-50">
  <div class="absolute inset-0 grid-dots opacity-[0.35] [mask-image:radial-gradient(ellipse_at_center,black_30%,transparent_75%)]"></div>
  <div class="orb orb-dark" style="width:420px;height:420px;bottom:-200px;left:-160px;"></div>

  <div class="section-inner relative px-6 md:px-12 pt-20 pb-16 md:pt-28 md:pb-20 grid lg:grid-cols-[1.15fr_1fr] gap-14 lg:gap-20 items-center">
    <div data-stagger>
      <div class="reveal"><Eyebrow>Your eyebrow</Eyebrow></div>
      <h1 class="display-xl mt-5 reveal" style="text-wrap:balance;">Your headline goes <em>right here.</em></h1>
      <p class="body-lg mt-6 max-w-xl reveal">Short, punchy subhead explaining what your product does and who it is for. Replace this copy in <code>src/sections/home/hero.astro</code>.</p>
      <div class="mt-8 flex flex-wrap items-center gap-3 reveal">
        <Button href="#" variant="primary">Primary action</Button>
        <Button href="/docs" variant="secondary">Read docs →</Button>
      </div>
      <p class="mt-3 text-xs text-neutral-500 reveal">Short supporting line under the CTAs.</p>
    </div>

    <div class="reveal relative">
      <div class="relative rounded-3xl bg-white/70 backdrop-blur-sm ring-1 ring-primaryColor/8 shadow-[0_30px_80px_-40px_rgb(16_35_35_/_0.25)] p-5 md:p-6">
        <div class="flex items-center gap-1.5 pb-3">
          <span class="h-2 w-2 rounded-full bg-neutral-200"></span>
          <span class="h-2 w-2 rounded-full bg-neutral-200"></span>
          <span class="h-2 w-2 rounded-full bg-neutral-200"></span>
          <span class="ml-2 text-[11px] font-mono text-neutral-400 uppercase tracking-wider">api.example.com</span>
        </div>
        <div class="code-panel-dark rounded-2xl ring-1 ring-neutral-800 overflow-hidden">
          <div class="px-4 py-2 border-b border-neutral-800 flex items-center justify-between text-[11px] font-mono uppercase tracking-wider text-neutral-400">
            <span>Quick start</span>
            <span class="text-neutral-500">curl</span>
          </div>
          <pre class="m-0 px-4 py-4 font-mono text-[12.5px] leading-relaxed text-neutral-100 overflow-x-auto"><code><span class="text-neutral-400"># Replace with your snippet</span>
<span class="text-primary-400">curl</span> https://api.example.com/v1/hello \
  -H <span style="color:#9DC8FF">"Authorization: Bearer $TOKEN"</span></code></pre>
        </div>
      </div>
    </div>
  </div>

  <div class="section-inner relative px-6 md:px-12 mt-4 md:mt-6 pb-20">
    <dl class="grid grid-cols-3 rule-top rule-btm divide-x divide-primaryColor/8 text-center reveal">
      {stats.map((s) => (
        <div class="py-7">
          <dt class="font-display text-3xl md:text-4xl font-bold text-primaryColor tracking-tight">{s.value}</dt>
          <dd class="mt-2 text-[11px] uppercase tracking-[0.12em] text-neutral-500 font-medium">{s.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
