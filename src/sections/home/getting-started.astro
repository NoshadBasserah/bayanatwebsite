---
import SectionHeader from "@/components/SectionHeader.astro";
import StepCard from "@/components/StepCard.astro";

const steps = [
  { number: 1, title: "Step one", body: "A single sentence describing what the reader does first." },
  { number: 2, title: "Step two", body: "Keep each step short — one concrete action per card." },
  { number: 3, title: "Step three", body: "End with the payoff the reader gets after all three steps." },
];
---

<section class="section bg-neutral-50">
  <div class="section-inner section-pad">
    <SectionHeader eyebrow="From zero to first result">
      <Fragment slot="title">Three steps, <em>five minutes.</em></Fragment>
    </SectionHeader>

    <div class="mt-14 grid md:grid-cols-3 gap-6 reveal">
      {steps.map((s) => (
        <StepCard number={s.number} title={s.title}>{s.body}</StepCard>
      ))}
    </div>
  </div>
</section>
