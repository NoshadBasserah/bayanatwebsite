---
import { render } from "astro:content";
import { getDocsByLang } from "@/data/post";
import DocsLayout from "@/layouts/Docs.astro";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";

export const getStaticPaths = (async () => {
  const docs = await getDocsByLang('ar');
  return docs.map((post) => {
    const rawId = String(post.id).replace(/^ar\//, '').replace(/^ar$/, '');
    const isIndex = rawId === 'index' || rawId === '';
    return {
      params: { slug: isIndex ? undefined : rawId },
      props: { post },
    };
  });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props;
const { Content } = await render(post);
---

<DocsLayout post={post} lang="ar">
  <Content />
</DocsLayout>
