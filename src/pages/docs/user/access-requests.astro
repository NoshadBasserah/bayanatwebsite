---
import BaseHead from "@/components/BaseHead.astro";
import SkipLink from "@/components/SkipLink.astro";
import Logo from "@/components/Logo.astro";
import Navigation from "@/components/docs/Navigation.astro";
import GuideBreadcrumbs from "@/components/docs/GuideBreadcrumbs.astro";
import GuideIntro from "@/components/docs/GuideIntro.astro";
import { docsNavSections, flattenNavItems } from "@/data/docsNav";
import { siteConfig } from "@/site.config";
import useraccessrequest1 from "@/assets/images/useraccessrequest1.svg";
import useraccessrequest2 from "@/assets/images/useraccessrequest2.svg";
import useraccessrequest3 from "@/assets/images/useraccessrequest3.svg";

const title = "Access Requests";
const description =
  "Users can request access to datasets, dashboards, and additional privileges.";

const allPages = flattenNavItems(docsNavSections);

function normalize(p: string) {
  return p.endsWith("/") ? p : `${p}/`;
}

const currentPath = normalize(Astro.url.pathname);
const currentIdx = allPages.findIndex((p) => normalize(p.href) === currentPath);

const prevPage = currentIdx > 0 ? allPages[currentIdx - 1] : null;
const nextPage =
  currentIdx >= 0 && currentIdx < allPages.length - 1
    ? allPages[currentIdx + 1]
    : null;

const tocHeadings = [
  { depth: 2, slug: "viewing-all-submitted-requests", text: "Viewing All Submitted Requests" },
  { depth: 2, slug: "view-request-details", text: "View Request Details" },
  { depth: 2, slug: "export-requests", text: "Export Requests" },
  { depth: 2, slug: "cancelling-a-request", text: "Cancelling a Request" },
];
---

<html
  class="scroll-pt-[88px] scroll-smooth font-sans antialiased"
  lang={siteConfig.lang}
  data-theme="light"
>
  <head>
    <BaseHead description={description} title={title} />
  </head>
  <body class="bg-neutral-50 text-neutral-800">
    <SkipLink />

    <div class="flex min-h-screen">
      <!-- Sidebar -->
      <aside class="sticky top-0 z-20 hidden h-screen w-[240px] shrink-0 flex-col overflow-y-auto border-r border-neutral-100 bg-white lg:flex">
        <div class="flex h-[72px] shrink-0 items-center border-b border-neutral-100 px-5">
          <a href="/" aria-label="BayanatiHub home">
            <Logo class="h-[47px] w-auto" />
          </a>
        </div>
        <div class="flex-1 overflow-y-auto">
          <Navigation />
        </div>
        <div class="shrink-0 p-3 pb-5">
          <div class="overflow-hidden rounded-[14px] border border-neutral-100 bg-gradient-to-b from-white to-[#e3f7ff] p-4">
            <p class="text-[13px] font-semibold text-[#0f172a]">Need help?</p>
            <p class="mt-1 text-[11px] leading-[16px] text-[#6b7689]">
              Find guides and tutorials to make the most of BayanatiHub.
            </p>
            <a
              href="#"
              class="mt-3 flex h-[34px] items-center justify-between rounded-[8px] border border-[#e5ecfe] bg-white px-3 text-[11.5px] font-semibold text-[#009ad6] transition-colors hover:bg-[#eff6ff]"
            >
              <span>View Help Center</span>
              <span aria-hidden="true">-&gt;</span>
            </a>
          </div>
        </div>
      </aside>

      <div class="flex min-w-0 flex-1 flex-col">
        <!-- Header -->
        <header class="sticky top-0 z-10 flex h-[72px] shrink-0 items-center justify-between gap-4 border-b border-neutral-100 bg-white px-6">
          <div class="flex h-[40px] w-full max-w-[420px] items-center gap-2 rounded-[10px] border border-neutral-100 bg-[#f7f8fb] px-3">
            <svg class="h-[12px] w-[12px] shrink-0 text-[#949eb0]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.35-4.35"></path>
            </svg>
            <span class="flex-1 text-[13px] text-[#949eb0]">Search documentation...</span>
            <div class="flex h-[22px] items-center rounded-[5px] border border-[#e5e9f0] bg-white px-2">
              <span class="text-[10.5px] font-medium text-[#6b7689]">⌘ K</span>
            </div>
          </div>
          <div class="flex shrink-0 items-center gap-3">
            <button aria-label="Toggle theme" class="hidden h-8 w-8 cursor-pointer items-center justify-center rounded-full text-neutral-900 transition-colors hover:bg-neutral-50 sm:flex">
              <svg class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
              </svg>
            </button>
            <button class="hidden items-center gap-1.5 rounded-full px-2 py-1 text-[11.5px] font-medium text-[#8796af] transition-colors hover:bg-neutral-50 sm:flex">
              <span>Arabic</span>
              <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
            </button>
          </div>
        </header>

        <div class="flex flex-1">
          <main id="main-content" class="min-w-0 flex-1 p-6 lg:p-8">
            <article data-docs-content class="docs-guide">

              <GuideBreadcrumbs
                items={[
                  { label: "Docs", href: "/docs/" },
                  { label: "As user role", href: "#" },
                  { label: "Access Requests" },
                ]}
              />

              <GuideIntro>
                <h1>Access Requests</h1>
                <p class="m-0 text-[15px] font-semibold text-[#0f172a] mb-3">Users can request access when:</p>
                <ul class="m-0 list-none space-y-2 p-0">
                  <li class="flex items-center gap-2 text-[14px] text-[#0f172a]">
                    <span class="font-bold text-[#64748b]">•</span>
                    A dataset is published but not assigned to them
                  </li>
                  <li class="flex items-center gap-2 text-[14px] text-[#0f172a]">
                    <span class="font-bold text-[#64748b]">•</span>
                    A dashboard exists but requires permission
                  </li>
                  <li class="flex items-center gap-2 text-[14px] text-[#0f172a]">
                    <span class="font-bold text-[#64748b]">•</span>
                    They need additional privileges (e.g., Add to Space, licenses)
                  </li>
                </ul>
              </GuideIntro>

              <!-- Info callout -->
              <div class="mt-2 flex gap-3 rounded-[12px] border border-[#dbeafe] bg-[#eff6ff] p-4">
                <svg class="mt-0.5 shrink-0 text-[#2563eb]" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="16" x2="12" y2="12"></line>
                  <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
                <p class="m-0 text-[14px] leading-relaxed text-[#0f172a]">
                  When navigating to the <strong class="text-[#009ad6]">My Requests</strong> , all requests submitted to me will be displayed
                </p>
              </div>

              <!-- Feature cards -->
              <div class="mt-6 space-y-4">

                <!-- Viewing All Submitted Requests -->
                <div class="overflow-hidden rounded-[14px] border border-[#edf1f7] bg-white shadow-[0px_2px_8px_rgba(24,36,64,0.04)]">
                  <div class="flex items-start gap-4 p-5">
                    <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-[8px] bg-[#f5f3ff]">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                      </svg>
                    </div>
                    <div class="flex min-w-0 flex-1 items-start justify-between gap-6">
                      <div class="flex-1">
                        <h3 id="viewing-all-submitted-requests" class="m-0 text-[15px] font-bold text-[#0f172a]">Viewing All Submitted Requests</h3>
                        <p class="mt-1.5 text-[13px] leading-relaxed text-[#64748b]">
                          When navigating to the <strong class="text-[#7c3aed]">My Requests</strong> tab, all requests submitted by you will be displayed in a list — including their current status, dataset name, request date, and assigned approver.
                        </p>
                      </div>
                      <div class="w-[160px] shrink-0 overflow-hidden rounded-[8px] border border-[#f1f5f9]">
                        <img src={useraccessrequest1.src} alt="Viewing All Submitted Requests" loading="lazy" class="h-auto w-full" />
                      </div>
                    </div>
                  </div>
                </div>

                <!-- View Request Details -->
                <div class="overflow-hidden rounded-[14px] border border-[#edf1f7] bg-white shadow-[0px_2px_8px_rgba(24,36,64,0.04)]">
                  <div class="flex items-start gap-4 p-5">
                    <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-[8px] bg-[#eff6ff]">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                      </svg>
                    </div>
                    <div class="flex min-w-0 flex-1 items-start justify-between gap-6">
                      <div class="flex-1">
                        <h3 id="view-request-details" class="m-0 text-[15px] font-bold text-[#0f172a]">View Request Details</h3>
                        <p class="mt-1.5 text-[13px] leading-relaxed text-[#64748b]">
                          Click the eye icon next to any request to open its full details panel, including all submitted metadata and the live audit log showing each status change.
                        </p>
                      </div>
                      <div class="w-[160px] shrink-0 overflow-hidden rounded-[8px] border border-[#f1f5f9]">
                        <img src={useraccessrequest2.src} alt="View Request Details" loading="lazy" class="h-auto w-full" />
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Export Requests -->
                <div class="overflow-hidden rounded-[14px] border border-[#edf1f7] bg-white shadow-[0px_2px_8px_rgba(24,36,64,0.04)]">
                  <div class="flex items-start gap-4 p-5">
                    <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-[8px] bg-[#f0fdf4]">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                      </svg>
                    </div>
                    <div class="flex min-w-0 flex-1 items-start justify-between gap-6">
                      <div class="flex-1">
                        <h3 id="export-requests" class="m-0 text-[15px] font-bold text-[#0f172a]">Export Requests</h3>
                        <p class="mt-1.5 text-[13px] leading-relaxed text-[#64748b]">
                          Click Export to download all your submitted requests as a file for offline review, reporting, or archiving.
                        </p>
                      </div>
                      <div class="w-[160px] shrink-0 overflow-hidden rounded-[8px] border border-[#f1f5f9]">
                        <img src={useraccessrequest3.src} alt="Export Requests" loading="lazy" class="h-auto w-full" />
                      </div>
                    </div>
                  </div>
                </div>

              </div>

              <!-- Cancelling a Request warning -->
              <div id="cancelling-a-request" class="mt-6 rounded-[12px] border border-[#ffedd5] bg-[#fff7ed] p-4">
                <div class="flex items-start gap-3">
                  <div class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full border-2 border-[#f97316]">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#f97316" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="18" y1="6" x2="6" y2="18"></line>
                      <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                  </div>
                  <div>
                    <p class="m-0 text-[14px] font-bold text-[#ea580c]">Cancelling a Request</p>
                    <p class="mt-1 text-[13px] leading-relaxed text-[#9a4b15]">
                      You can cancel your request <strong>before it is approved</strong> by the admin. Once approved, the request cannot be cancelled from your end and will require admin action.
                    </p>
                  </div>
                </div>
              </div>

              <!-- Audit log callout -->
              <div class="mt-4 flex gap-3 rounded-[12px] border border-[#dbeafe] bg-[#eff6ff] p-4">
                <svg class="mt-0.5 shrink-0 text-[#2563eb]" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="16" x2="12" y2="12"></line>
                  <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
                <p class="m-0 text-[13px] leading-relaxed text-[#0f172a]">
                  The <strong class="text-[#009ad6]">audit log</strong> in the View Details panel records every status transition — who acted on the request, what action was taken, and when — giving you full transparency over your request lifecycle.
                </p>
              </div>

            </article>

            {(prevPage || nextPage) && (
              <div class="mt-6 flex gap-4">
                {prevPage ? (
                  <a
                    href={prevPage.href}
                    class="flex flex-1 items-center gap-4 rounded-[14px] border border-neutral-100 bg-white px-5 py-5 shadow-[0px_2px_8px_0px_rgba(24,36,64,0.03)] transition-shadow hover:shadow-md"
                  >
                    <span class="text-[18px] font-medium text-[#6b7689]">&lt;-</span>
                    <div>
                      <p class="text-[11px] font-medium uppercase tracking-[0.04em] text-[#6b7689]">Previous</p>
                      <p class="mt-0.5 text-[15px] font-semibold tracking-[-0.003em] text-[#0f172a]">{prevPage.title}</p>
                    </div>
                  </a>
                ) : (
                  <div class="flex-1"></div>
                )}

                {nextPage ? (
                  <a
                    href={nextPage.href}
                    class="flex flex-1 items-center justify-end gap-4 rounded-[14px] border border-neutral-100 bg-white px-5 py-5 shadow-[0px_2px_8px_0px_rgba(24,36,64,0.03)] transition-shadow hover:shadow-md"
                  >
                    <div class="text-right">
                      <p class="text-[11px] font-medium uppercase tracking-[0.04em] text-[#6b7689]">Next</p>
                      <p class="mt-0.5 text-[15px] font-semibold tracking-[-0.003em] text-[#0f172a]">{nextPage.title}</p>
                    </div>
                    <span class="text-[18px] font-medium text-[#6b7689]">-&gt;</span>
                  </a>
                ) : (
                  <div class="flex-1"></div>
                )}
              </div>
            )}
          </main>

          <!-- TOC -->
          <aside class="hidden xl:block w-[260px] shrink-0 sticky top-[72px] h-[calc(100vh-72px)] overflow-y-auto p-5 ps-0">
            <div class="rounded-[14px] border border-neutral-100 bg-white p-4 shadow-[0px_2px_8px_rgba(24,36,64,0.03)]">
              <p class="mb-3 text-sm font-semibold tracking-[-0.003em] text-[#0f172a]">On this page</p>
              <div class="mb-3 h-px bg-[#f0f3f7]"></div>
              <ul class="space-y-[10px]">
                {tocHeadings.map((h, i) => (
                  <li class="flex items-center gap-2">
                    <div class:list={[
                      "h-[18px] w-[2.5px] shrink-0 rounded-xl transition-colors",
                      i === 0 ? "bg-[#009ad6]" : "bg-transparent",
                    ]} />
                    <a
                      href={`#${h.slug}`}
                      class:list={[
                        "text-[12.5px] leading-5 transition-colors",
                        i === 0
                          ? "font-semibold text-[#009ad6]"
                          : "font-medium text-[#374151] hover:text-[#009ad6]",
                      ]}
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </body>
</html>
