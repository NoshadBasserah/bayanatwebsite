---
import BaseHead from "@/components/BaseHead.astro";
import SkipLink from "@/components/SkipLink.astro";
import Logo from "@/components/Logo.astro";
import Navigation from "@/components/docs/Navigation.astro";
import GuideBreadcrumbs from "@/components/docs/GuideBreadcrumbs.astro";
import GuideIntro from "@/components/docs/GuideIntro.astro";
import GuideStepCard from "@/components/docs/GuideStepCard.astro";
import { docsNavSections, flattenNavItems } from "@/data/docsNav";
import { siteConfig } from "@/site.config";
import stepOne from "@/assets/images/teamandspaceimage1.svg";
import stepTwo from "@/assets/images/teamandspaceimage2.svg";
import stepThree from "@/assets/images/teamandspaceimage3.svg";
import stepFour from "@/assets/images/teamandspaceimage4.svg";
import stepFive from "@/assets/images/teamandspaceimage5.svg";

const title = "Team & Spaces";
const description =
  "Collaborate with your team by creating shared spaces, managing members, and organizing assets.";

const allPages = flattenNavItems(docsNavSections);

function normalize(p: string) {
  return p.endsWith("/") ? p : `${p}/`;
}

const currentPath = normalize(Astro.url.pathname);
const currentIdx = allPages.findIndex((p) => normalize(p.href) === currentPath);

const prevPage = currentIdx > 0 ? allPages[currentIdx - 1] : null;
const nextPage =
  currentIdx >= 0 && currentIdx < allPages.length - 1
    ? allPages[currentIdx + 1]
    : null;

const tocHeadings = [
  {
    depth: 2,
    slug: "steps-to-create-a-team-and-space",
    text: "Steps to Create a Team and Space:",
  },
  { depth: 2, slug: "additional-information", text: "Additional Information" },
];
---

<html
  class="scroll-pt-[88px] scroll-smooth font-sans antialiased"
  lang={siteConfig.lang}
  data-theme="light"
>
  <head>
    <BaseHead description={description} title={title} />
  </head>
  <body class="bg-neutral-50 text-neutral-800">
    <SkipLink />

    <div class="flex min-h-screen">
      <!-- Sidebar -->
      <aside
        class="sticky top-0 z-20 hidden h-screen w-[240px] shrink-0 flex-col overflow-y-auto border-r border-neutral-100 bg-white lg:flex"
      >
        <div
          class="flex h-[72px] shrink-0 items-center border-b border-neutral-100 px-5"
        >
          <a href="/" aria-label="BayanatiHub home">
            <Logo class="h-[47px] w-auto" />
          </a>
        </div>
        <div class="flex-1 overflow-y-auto">
          <Navigation />
        </div>
        <div class="shrink-0 p-3 pb-5">
          <div
            class="overflow-hidden rounded-[14px] border border-neutral-100 bg-gradient-to-b from-white to-[#e3f7ff] p-4"
          >
            <p class="text-[13px] font-semibold text-[#0f172a]">Need help?</p>
            <p class="mt-1 text-[11px] leading-[16px] text-[#6b7689]">
              Find guides and tutorials to make the most of BayanatiHub.
            </p>
            <a
              href="#"
              class="mt-3 flex h-[34px] items-center justify-between rounded-[8px] border border-[#e5ecfe] bg-white px-3 text-[11.5px] font-semibold text-[#009ad6] transition-colors hover:bg-[#eff6ff]"
            >
              <span>View Help Center</span>
              <span aria-hidden="true">-&gt;</span>
            </a>
          </div>
        </div>
      </aside>

      <div class="flex min-w-0 flex-1 flex-col">
        <!-- Header -->
        <header
          class="sticky top-0 z-10 flex h-[72px] shrink-0 items-center justify-between gap-4 border-b border-neutral-100 bg-white px-6"
        >
          <div
            class="flex h-[40px] w-full max-w-[420px] items-center gap-2 rounded-[10px] border border-neutral-100 bg-[#f7f8fb] px-3"
          >
            <svg
              class="h-[12px] w-[12px] shrink-0 text-[#949eb0]"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              viewBox="0 0 24 24"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.35-4.35"></path>
            </svg>
            <span class="flex-1 text-[13px] text-[#949eb0]"
              >Search documentation...</span
            >
            <div
              class="flex h-[22px] items-center rounded-[5px] border border-[#e5e9f0] bg-white px-2"
            >
              <span class="text-[10.5px] font-medium text-[#6b7689]">⌘ K</span>
            </div>
          </div>
          <div class="flex shrink-0 items-center gap-3">
            <button
              aria-label="Toggle theme"
              class="hidden h-8 w-8 cursor-pointer items-center justify-center rounded-full text-neutral-900 transition-colors hover:bg-neutral-50 sm:flex"
            >
              <svg
                class="h-[18px] w-[18px]"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <circle cx="12" cy="12" r="4"></circle>
                <path
                  d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
                ></path>
              </svg>
            </button>
            <button
              class="hidden items-center gap-1.5 rounded-full px-2 py-1 text-[11.5px] font-medium text-[#8796af] transition-colors hover:bg-neutral-50 sm:flex"
            >
              <span>Arabic</span>
              <svg
                class="h-4 w-4"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <path
                  d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
                ></path>
              </svg>
            </button>
          </div>
        </header>

        <div class="flex flex-1">
          <main id="main-content" class="min-w-0 flex-1 p-6 lg:p-8">
            <article data-docs-content class="docs-guide">
              <GuideBreadcrumbs
                items={[
                  { label: "Docs", href: "/docs/" },
                  { label: "As user role", href: "#" },
                  { label: "Team & Spaces" },
                ]}
              />

              <GuideIntro>
                <h1>Team &amp; Spaces</h1>
                <p>
                  This tab allows users to create and manage teams, and spaces
                  for collaboration among members.
                </p>
                <p>
                  it enables users to share information, access resources,
                  create dashboards, communicats, and work, together effectively
                  as a team.
                </p>
              </GuideIntro>

              <!-- Feature overview cards -->
              <div class="mt-4 mb-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
                <div
                  class="rounded-[16px] border border-[#edf1f7] bg-white p-5"
                >
                  <div
                    class="mb-3 flex h-10 w-10 items-center justify-center rounded-[10px] bg-[#ede9fe]"
                  >
                    <svg
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="#7c3aed"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"
                      ></path>
                      <circle cx="9" cy="7" r="4"></circle>
                      <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                      <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                  </div>
                  <p class="m-0 text-[14px] font-semibold text-[#0f172a]">
                    Collaborate
                  </p>
                  <p
                    class="m-0 mt-1 text-[13px] leading-relaxed text-[#66758f]"
                  >
                    Work together in shared spaces
                  </p>
                </div>

                <div
                  class="rounded-[16px] border border-[#edf1f7] bg-white p-5"
                >
                  <div
                    class="mb-3 flex h-10 w-10 items-center justify-center rounded-[10px] bg-[#dbeafe]"
                  >
                    <svg
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="#2563eb"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path
                        d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
                      ></path>
                    </svg>
                  </div>
                  <p class="m-0 text-[14px] font-semibold text-[#0f172a]">
                    Communicate
                  </p>
                  <p
                    class="m-0 mt-1 text-[13px] leading-relaxed text-[#66758f]"
                  >
                    Chat directly in spaces
                  </p>
                </div>

                <div
                  class="rounded-[16px] border border-[#edf1f7] bg-white p-5"
                >
                  <div
                    class="mb-3 flex h-10 w-10 items-center justify-center rounded-[10px] bg-[#d1fae5]"
                  >
                    <svg
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="#059669"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path
                        d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                      ></path>
                      <polyline points="14 2 14 8 20 8"></polyline>
                      <line x1="12" y1="18" x2="12" y2="12"></line>
                      <line x1="9" y1="15" x2="15" y2="15"></line>
                    </svg>
                  </div>
                  <p class="m-0 text-[14px] font-semibold text-[#0f172a]">
                    Share Assets
                  </p>
                  <p
                    class="m-0 mt-1 text-[13px] leading-relaxed text-[#66758f]"
                  >
                    Forms, Dashboards &amp; more
                  </p>
                </div>

                <div
                  class="rounded-[16px] border border-[#edf1f7] bg-white p-5"
                >
                  <div
                    class="mb-3 flex h-10 w-10 items-center justify-center rounded-[10px] bg-[#fef3c7]"
                  >
                    <svg
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="#d97706"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"
                      ></rect>
                      <line x1="16" y1="2" x2="16" y2="6"></line>
                      <line x1="8" y1="2" x2="8" y2="6"></line>
                      <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                  </div>
                  <p class="m-0 text-[14px] font-semibold text-[#0f172a]">
                    Plan Tasks
                  </p>
                  <p
                    class="m-0 mt-1 text-[13px] leading-relaxed text-[#66758f]"
                  >
                    Planner inside your space
                  </p>
                </div>
              </div>

              <!-- Steps section -->
              <h2 id="steps-to-create-a-team-and-space">
                Steps to Create a Team and Space:
              </h2>

              <div class="docs-step-list">
                <GuideStepCard
                  number={1}
                  title="Navigate to the Teams & Spaces"
                  description="Tab on the Teams."
                  image={stepOne}
                  imageAlt="Navigate to the Teams & Spaces"
                />

                <GuideStepCard
                  number={2}
                  title="Enter Details"
                  description="nter the required details (Name and Description)."
                  image={stepTwo}
                  imageAlt="Enter Details"
                />

                <GuideStepCard
                  number={3}
                  title="Click on Open Team."
                  description={`A pop-up will appear with the following message. Within the team, you can create spaces, add members, share assets, and communicats effectively.`}
                  image={stepThree}
                  imageAlt="Click on Open Team"
                />
                <GuideStepCard
                  number={4}
                  title="Create New Space"
                  description={`Enter the required details (Space Name and Description) Add members and select assets such as Forms, Dashboards, Planners, or Data Assets.`}
                  image={stepFour}
                  imageAlt="Create New Space"
                />
              </div>

              <!-- Additional info cards -->
              <h2 id="additional-information" class="sr-only">
                Additional Information
              </h2>

              <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div
                  class="flex items-start gap-4 rounded-[16px] border border-[#edf1f7] bg-white p-4"
                >
                  <div
                    class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[10px] bg-[#dbeafe]"
                  >
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="#2563eb"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"
                      ></rect>
                      <line x1="12" y1="3" x2="12" y2="21"></line>
                      <path d="M3 12h18"></path>
                    </svg>
                  </div>
                  <div>
                    <p class="m-0 text-[14px] font-semibold text-[#0f172a]">
                      Multiple Spaces
                    </p>
                    <p
                      class="m-0 mt-1 max-w-xl text-[13px] leading-relaxed text-[#66758f]"
                    >
                      You can create multiple spaces within the same team to
                      organize different projects or topics.
                    </p>
                  </div>
                </div>

                <div
                  class="flex items-start gap-4 rounded-[16px] border border-[#edf1f7] bg-white p-4"
                >
                  <div
                    class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[10px] bg-[#ede9fe]"
                  >
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="#7c3aed"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path
                        d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
                      ></path>
                    </svg>
                  </div>
                  <div>
                    <p class="m-0 text-[14px] font-semibold text-[#0f172a]">
                      Team Chat
                    </p>
                    <p
                      class="m-0 mt-1 text-[13px] leading-relaxed text-[#66758f]"
                    >
                      Communicate with team members within a space by clicking
                      the chat icon.
                    </p>
                  </div>
                </div>

                <div
                  class="flex items-start gap-4 rounded-[16px] border border-[#edf1f7] bg-white p-4"
                >
                  <div
                    class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[10px] bg-[#ccfbf1]"
                  >
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="#0d9488"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path
                        d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"
                      ></path>
                      <path
                        d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"
                      ></path>
                    </svg>
                  </div>
                  <div>
                    <p class="m-0 text-[14px] font-semibold text-[#0f172a]">
                      Edit Team or Space
                    </p>
                    <p
                      class="m-0 mt-1 text-[13px] leading-relaxed text-[#66758f]"
                    >
                      Click the pencil (edit) icon to update the name of any
                      team or space.
                    </p>
                  </div>
                </div>

                <div
                  class="flex items-start gap-4 rounded-[16px] border border-[#fee2e2] bg-[#fef2f2] p-4"
                >
                  <div
                    class="flex h-10 w-10 shrink-0 items-center justify-center rounded-[10px] bg-[#fee2e2]"
                  >
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="#ef4444"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polyline points="3 6 5 6 21 6"></polyline>
                      <path
                        d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
                      ></path>
                    </svg>
                  </div>
                  <div>
                    <p class="m-0 text-[14px] font-semibold text-[#0f172a]">
                      Delete a Space
                    </p>
                    <p
                      class="m-0 mt-1 text-[13px] leading-relaxed text-[#66758f]"
                    >
                      Select the space, click the three-dot menu, and choose
                      Delete Space.
                    </p>
                  </div>
                </div>
              </div>

              <!-- Planner section -->
              <div class="docs-step-card mt-8">
                <div class="docs-step-card__panel">
                  <div class="docs-step-card__body">
                    <div class="mb-2 flex items-center gap-3">
                      <div
                        class="flex h-7 w-7 items-center justify-center rounded-[6px] bg-[#dbeafe]"
                      >
                        <svg
                          width="16"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="#2563eb"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"
                          ></rect>
                          <line x1="16" y1="2" x2="16" y2="6"></line>
                          <line x1="8" y1="2" x2="8" y2="6"></line>
                          <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                      </div>
                      <h3 class="m-0 text-[16px] font-bold text-[#0f172a]">
                        Adding a Planner &amp; Managing Tasks
                      </h3>
                    </div>
                    <p class="m-0 text-[14px] text-[#66758f]">
                      When a Planner is added to your space, you can create and
                      manage tasks for the team directly within the space.
                    </p>
                    <div class="mt-4 space-y-3">
                      <div class="flex items-start gap-3">
                        <div
                          class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#009ad6] text-[11px] font-bold text-white"
                        >
                          1
                        </div>
                        <p
                          class="m-0 text-[13.5px] leading-relaxed text-[#475569]"
                        >
                          Click Add Planner, then select Add Task.
                        </p>
                      </div>
                      <div class="flex items-start gap-3">
                        <div
                          class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#009ad6] text-[11px] font-bold text-white"
                        >
                          2
                        </div>
                        <p
                          class="m-0 text-[13.5px] leading-relaxed text-[#475569]"
                        >
                          Enter task details: Assignee, Start Date, End Date,
                          Priority, and Notes.
                        </p>
                      </div>
                      <div class="flex items-start gap-3">
                        <div
                          class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#009ad6] text-[11px] font-bold text-white"
                        >
                          3
                        </div>
                        <p
                          class="m-0 text-[13.5px] leading-relaxed text-[#475569]"
                        >
                          Click Save to create the task.
                        </p>
                      </div>
                    </div>
                  </div>
                  <div class="docs-step-card__media">
                    <img
                      src={stepFive.src}
                      alt="Adding a Planner"
                      loading="lazy"
                    />
                  </div>
                </div>
              </div>

              <!-- Callout -->
              <div
                class="mt-8 flex gap-3 rounded-[12px] border border-[#dbeafe] bg-[#eff6ff] p-4"
              >
                <svg
                  class="mt-0.5 shrink-0 text-[#2563eb]"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="16" x2="12" y2="12"></line>
                  <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
                <p
                  class="m-0 text-[13px] leading-relaxed font-medium text-[#2563eb]"
                >
                  Spaces within the same team can each have their own members,
                  assets, and planners — allowing fine-grained access control
                  and collaboration scoping per project.
                </p>
              </div>
            </article>

            {
              (prevPage || nextPage) && (
                <div class="mt-6 flex gap-4">
                  {prevPage ? (
                    <a
                      href={prevPage.href}
                      class="flex flex-1 items-center gap-4 rounded-[14px] border border-neutral-100 bg-white px-5 py-5 shadow-[0px_2px_8px_0px_rgba(24,36,64,0.03)] transition-shadow hover:shadow-md"
                    >
                      <span class="text-[18px] font-medium text-[#6b7689]">
                        &lt;-
                      </span>
                      <div>
                        <p class="text-[11px] font-medium tracking-[0.04em] text-[#6b7689] uppercase">
                          Previous
                        </p>
                        <p class="mt-0.5 text-[15px] font-semibold tracking-[-0.003em] text-[#0f172a]">
                          {prevPage.title}
                        </p>
                      </div>
                    </a>
                  ) : (
                    <div class="flex-1" />
                  )}

                  {nextPage ? (
                    <a
                      href={nextPage.href}
                      class="flex flex-1 items-center justify-end gap-4 rounded-[14px] border border-neutral-100 bg-white px-5 py-5 shadow-[0px_2px_8px_0px_rgba(24,36,64,0.03)] transition-shadow hover:shadow-md"
                    >
                      <div class="text-right">
                        <p class="text-[11px] font-medium tracking-[0.04em] text-[#6b7689] uppercase">
                          Next
                        </p>
                        <p class="mt-0.5 text-[15px] font-semibold tracking-[-0.003em] text-[#0f172a]">
                          {nextPage.title}
                        </p>
                      </div>
                      <span class="text-[18px] font-medium text-[#6b7689]">
                        -&gt;
                      </span>
                    </a>
                  ) : (
                    <div class="flex-1" />
                  )}
                </div>
              )
            }
          </main>

          <!-- TOC -->
          <aside
            class="sticky top-[72px] hidden h-[calc(100vh-72px)] w-[260px] shrink-0 overflow-y-auto p-5 ps-0 xl:block"
          >
            <div
              class="rounded-[14px] border border-neutral-100 bg-white p-4 shadow-[0px_2px_8px_rgba(24,36,64,0.03)]"
            >
              <p
                class="mb-3 text-sm font-semibold tracking-[-0.003em] text-[#0f172a]"
              >
                On this page
              </p>
              <div class="mb-3 h-px bg-[#f0f3f7]"></div>
              <ul class="space-y-[10px]">
                {
                  tocHeadings.map((h, i) => (
                    <li class="flex items-center gap-2">
                      <div
                        class:list={[
                          "h-[18px] w-[2.5px] shrink-0 rounded-xl transition-colors",
                          i === 0 ? "bg-[#009ad6]" : "bg-transparent",
                        ]}
                      />
                      <a
                        href={`#${h.slug}`}
                        class:list={[
                          "text-[12.5px] leading-5 transition-colors",
                          i === 0
                            ? "font-semibold text-[#009ad6]"
                            : "font-medium text-[#374151] hover:text-[#009ad6]",
                        ]}
                      >
                        {h.text}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </aside>
        </div>
