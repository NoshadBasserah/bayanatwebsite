---
import BaseHead from "@/components/BaseHead.astro";
import SkipLink from "@/components/SkipLink.astro";
import Logo from "@/components/Logo.astro";
import Navigation from "@/components/docs/Navigation.astro";
import { docsNavSections, flattenNavItems } from "@/data/docsNav";
import { siteConfig } from "@/site.config";
import DataAssetsPage from "@/content/docs/user/data-assets.mdx";

const title = "Data Assets";
const description =
  "In this tab, all published data assets are displayed, including those from Databases, Pipelines, Dashboards and Metadata.";

const allPages = flattenNavItems(docsNavSections);

function normalize(p: string) {
  return p.endsWith("/") ? p : `${p}/`;
}

const currentPath = normalize(Astro.url.pathname);
const currentIdx = allPages.findIndex((p) => normalize(p.href) === currentPath);

const prevPage = currentIdx > 0 ? allPages[currentIdx - 1] : null;
const nextPage =
  currentIdx >= 0 && currentIdx < allPages.length - 1
    ? allPages[currentIdx + 1]
    : null;

const tocHeadings = [
  {
    depth: 2,
    slug: "steps-to-request-access-to-a-data-asset",
    text: "Steps to Request Access to a Data Asset",
  },
];
---

<html
  class="scroll-pt-[88px] scroll-smooth font-sans antialiased"
  lang={siteConfig.lang}
  data-theme="light"
>
  <head>
    <BaseHead description={description} title={title} />
  </head>
  <body class="bg-neutral-50 text-neutral-800">
    <SkipLink />

    <div class="flex min-h-screen">
      <!-- Sidebar -->
      <aside
        class="sticky top-0 z-20 hidden h-screen w-[240px] shrink-0 flex-col overflow-y-auto border-r border-neutral-100 bg-white lg:flex"
      >
        <div
          class="flex h-[72px] shrink-0 items-center border-b border-neutral-100 px-5"
        >
          <a href="/" aria-label="BayanatiHub home">
            <Logo class="h-[47px] w-auto" />
          </a>
        </div>

        <div class="flex-1 overflow-y-auto">
          <Navigation />
        </div>

        <div class="shrink-0 p-3 pb-5">
          <div
            class="overflow-hidden rounded-[14px] border border-neutral-100 bg-gradient-to-b from-white to-[#e3f7ff] p-4"
          >
            <p class="text-[13px] font-semibold text-[#0f172a]">Need help?</p>
            <p class="mt-1 text-[11px] leading-[16px] text-[#6b7689]">
              Find guides and tutorials to make the most of BayanatiHub.
            </p>
            <a
              href="#"
              class="mt-3 flex h-[34px] items-center justify-between rounded-[8px] border border-[#e5ecfe] bg-white px-3 text-[11.5px] font-semibold text-[#009ad6] transition-colors hover:bg-[#eff6ff]"
            >
              <span>View Help Center</span>
              <span aria-hidden="true">-&gt;</span>
            </a>
          </div>
        </div>
      </aside>

      <div class="flex min-w-0 flex-1 flex-col">
        <!-- Header -->
        <header
          class="sticky top-0 z-10 flex h-[72px] shrink-0 items-center justify-between gap-4 border-b border-neutral-100 bg-white px-6"
        >
          <div
            class="flex h-[40px] w-full max-w-[420px] items-center gap-2 rounded-[10px] border border-neutral-100 bg-[#f7f8fb] px-3"
          >
            <svg
              class="h-[12px] w-[12px] shrink-0 text-[#949eb0]"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              viewBox="0 0 24 24"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.35-4.35"></path>
            </svg>
            <span class="flex-1 text-[13px] text-[#949eb0]"
              >Search documentation...</span
            >
            <div
              class="flex h-[22px] items-center rounded-[5px] border border-[#e5e9f0] bg-white px-2"
            >
              <span class="text-[10.5px] font-medium text-[#6b7689]">⌘ K</span>
            </div>
          </div>

          <div class="flex shrink-0 items-center gap-3">
            <button
              aria-label="Toggle theme"
              class="hidden h-8 w-8 cursor-pointer items-center justify-center rounded-full text-neutral-900 transition-colors hover:bg-neutral-50 sm:flex"
            >
              <svg
                class="h-[18px] w-[18px]"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <circle cx="12" cy="12" r="4"></circle>
                <path
                  d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
                ></path>
              </svg>
            </button>
            <button
              class="hidden items-center gap-1.5 rounded-full px-2 py-1 text-[11.5px] font-medium text-[#8796af] transition-colors hover:bg-neutral-50 sm:flex"
            >
              <span>Arabic</span>
              <svg
                class="h-4 w-4"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <path
                  d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
                ></path>
              </svg>
            </button>
          </div>
        </header>

        <div class="flex flex-1">
          <main id="main-content" class="min-w-0 flex-1 p-6 lg:p-8">
            <article data-docs-content class="docs-guide">
              <DataAssetsPage />
            </article>

            {
              (prevPage || nextPage) && (
                <div class="mt-6 flex gap-4">
                  {prevPage ? (
                    <a
                      href={prevPage.href}
                      class="flex flex-1 items-center gap-4 rounded-[14px] border border-neutral-100 bg-white px-5 py-5 shadow-[0px_2px_8px_0px_rgba(24,36,64,0.03)] transition-shadow hover:shadow-md"
                    >
                      <span class="text-[18px] font-medium text-[#6b7689]">
                        &lt;-
                      </span>
                      <div>
                        <p class="text-[11px] font-medium tracking-[0.04em] text-[#6b7689] uppercase">
                          Previous
                        </p>
                        <p class="mt-0.5 text-[15px] font-semibold tracking-[-0.003em] text-[#0f172a]">
                          {prevPage.title}
                        </p>
                      </div>
                    </a>
                  ) : (
                    <div class="flex-1" />
                  )}

                  {nextPage ? (
                    <a
                      href={nextPage.href}
                      class="flex flex-1 items-center justify-end gap-4 rounded-[14px] border border-neutral-100 bg-white px-5 py-5 shadow-[0px_2px_8px_0px_rgba(24,36,64,0.03)] transition-shadow hover:shadow-md"
                    >
                      <div class="text-right">
                        <p class="text-[11px] font-medium tracking-[0.04em] text-[#6b7689] uppercase">
                          Next
                        </p>
                        <p class="mt-0.5 text-[15px] font-semibold tracking-[-0.003em] text-[#0f172a]">
                          {nextPage.title}
                        </p>
                      </div>
                      <span class="text-[18px] font-medium text-[#6b7689]">
                        -&gt;
                      </span>
                    </a>
                  ) : (
                    <div class="flex-1" />
                  )}
                </div>
              )
            }
          </main>

          <!-- TOC -->
          <aside
            class="sticky top-[72px] hidden h-[calc(100vh-72px)] w-[260px] shrink-0 overflow-y-auto p-5 ps-0 xl:block"
          >
            <div
              class="rounded-[14px] border border-neutral-100 bg-white p-4 shadow-[0px_2px_8px_rgba(24,36,64,0.03)]"
            >
              <p
                class="mb-3 text-sm font-semibold tracking-[-0.003em] text-[#0f172a]"
              >
                On this page
              </p>
              <div class="mb-3 h-px bg-[#f0f3f7]"></div>
              <ul class="space-y-[10px]">
                {
                  tocHeadings.map((h, i) => (
                    <li class="flex items-center gap-2">
                      <div
                        class:list={[
                          "h-[18px] w-[2.5px] shrink-0 rounded-xl transition-colors",
                          i === 0 ? "bg-[#009ad6]" : "bg-transparent",
                        ]}
                      />
                      <a
                        href={`#${h.slug}`}
                        class:list={[
                          "text-[12.5px] leading-5 transition-colors",
                          i === 0
                            ? "font-semibold text-[#009ad6]"
                            : "font-medium text-[#374151] hover:text-[#009ad6]",
                        ]}
                      >
                        {h.text}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </body>
</html>
