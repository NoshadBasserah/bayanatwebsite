---
import BaseLayout from "@/layouts/Base.astro";
import Button from "@/components/Button.astro";
import { Icon } from "astro-icon/components";

const meta = {
  description: "The page you were looking for isn't here.",
  title: "Page not found — ScrapeOwl",
};
---

<BaseLayout meta={meta}>
  <section slot="hero" class="section relative isolate overflow-hidden pt-32 sm:pt-36">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
      <span class="absolute left-[10%] top-[20%] h-40 w-40 rounded-full bg-[color:var(--color-surface-peach)] opacity-70 blur-3xl"></span>
      <span class="absolute right-[12%] top-[14%] h-48 w-48 rounded-full bg-[color:var(--color-surface-lilac)] opacity-70 blur-3xl"></span>
      <span class="absolute left-[45%] top-[62%] h-36 w-36 rounded-full bg-[color:var(--color-surface-mint)] opacity-60 blur-3xl"></span>
      <span class="absolute right-[30%] bottom-[10%] h-28 w-28 rounded-full bg-[color:var(--color-surface-cream)] opacity-70 blur-3xl"></span>
    </div>

    <div class="section-inner relative px-5 pb-24 text-center sm:px-8">
      <span class="eyebrow">404</span>
      <h1 class="display-lg mx-auto mt-5 max-w-3xl text-balance">
        This page <em>wandered off</em>.
      </h1>
      <p class="body-lg mx-auto mt-6 max-w-2xl">
        The link might be broken, or the page may have moved. Head back to the homepage or dig into the docs to find what you need.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <Button href="/" variant="primary" size="lg">
          Back home
          <Icon name="hugeicons:arrow-right-01" class="h-4 w-4" aria-hidden="true" />
        </Button>
        <Button href="/docs/" variant="secondary" size="lg">
          Read the docs
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
